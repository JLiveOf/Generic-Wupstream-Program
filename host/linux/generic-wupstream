        self.gamepad_path = path
        self.test_pad.set_sensitive(bool(path))

    def test_virtual_gamepad(self, *_):
        if not self.gamepad_path:
            return
        try:
            device = InputDevice(self.gamepad_path)
        except OSError as error:
            self.status.set_text(str(error))
            return
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                   text=self.tr("Probar mando virtual"))
        dialog.add_button(self.tr("Cerrar"), Gtk.ResponseType.CLOSE)

        def refresh():
            try:
                keys = ", ".join(map(str, device.active_keys(verbose=True))) or "—"
                axes = "  ".join(f"{ecodes.ABS[code]} {device.absinfo(code).value}" for code in (
                    ecodes.ABS_X, ecodes.ABS_Y, ecodes.ABS_RX, ecodes.ABS_RY,
                    ecodes.ABS_Z, ecodes.ABS_RZ, ecodes.ABS_HAT0X, ecodes.ABS_HAT0Y))
                dialog.format_secondary_text(f"{device.name}\n{keys}\n{axes}")
            except OSError:
                dialog.format_secondary_text(self.tr("El mando virtual se ha desconectado."))
            return GLib.SOURCE_CONTINUE

        refresh()
        timer = GLib.timeout_add(75, refresh)
        try:
            dialog.run()
        finally:
            GLib.source_remove(timer)
            device.close()
            dialog.destroy()

