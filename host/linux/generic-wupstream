class ScreenCast:
    def __init__(self, tr):
        self.tr = tr
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.session = None
        self.fd = None

    def request(self, method, signature, arguments, options):
        token = "wup_" + uuid.uuid4().hex
        options["handle_token"] = GLib.Variant("s", token)
        sender = self.bus.get_unique_name()[1:].replace(".", "_")
        path = f"{PORTAL_PATH}/request/{sender}/{token}"
        loop = GLib.MainLoop()
        response = []

        def received(bus, sender, object_path, interface, signal, parameters, *_):
            response.extend(parameters.unpack())
            loop.quit()

        listener = self.bus.signal_subscribe(PORTAL, "org.freedesktop.portal.Request",
                                             "Response", path, None, Gio.DBusSignalFlags.NONE, received)
        deadline = GLib.timeout_source_new_seconds(90)
        deadline.set_callback(lambda *_: loop.quit() or GLib.SOURCE_REMOVE)
        deadline.attach(None)
        try:
            handle = self.bus.call_sync(PORTAL, PORTAL_PATH, SCREENCAST, method,
                                        GLib.Variant(signature, (*arguments, options)), None,
                                        Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
            if handle != path:
                raise RuntimeError(self.tr("El portal devolvió una ruta de solicitud inesperada."))
            if not response:
                loop.run()
            if not response:
                self.bus.call(PORTAL, path, "org.freedesktop.portal.Request", "Close",
                              None, None, Gio.DBusCallFlags.NONE, 1000, None, None)
                raise RuntimeError(self.tr("El portal de captura no respondió."))
            if response[0] != 0:
                raise RuntimeError(self.tr("Se canceló la captura de pantalla."))
            return response[1]
        finally:
            deadline.destroy()
            self.bus.signal_unsubscribe(listener)

    def open(self):
        session_token = GLib.Variant("s", "wup_" + uuid.uuid4().hex)
        self.session = self.request("CreateSession", "(a{sv})", (),
                                    {"session_handle_token": session_token})["session_handle"]
        modes = self.bus.call_sync(PORTAL, PORTAL_PATH, "org.freedesktop.DBus.Properties", "Get",
                                   GLib.Variant("(ss)", (SCREENCAST, "AvailableCursorModes")), None,
                                   Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]
        self.request("SelectSources", "(oa{sv})", (self.session,),
                     {"types": GLib.Variant("u", 1), "cursor_mode": GLib.Variant("u", 2 if modes & 2 else 1)})
        stream = self.request("Start", "(osa{sv})", (self.session, ""), {})["streams"][0][0]
        result, descriptor_list = self.bus.call_with_unix_fd_list_sync(
            PORTAL, PORTAL_PATH, SCREENCAST, "OpenPipeWireRemote",
            GLib.Variant("(oa{sv})", (self.session, {})), None,
            Gio.DBusCallFlags.NONE, 5000, None, None)
        self.fd = descriptor_list.get(result.unpack()[0])
        return f"pipewiresrc fd={self.fd} path={stream}"

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None
        if self.session:
            self.bus.call(PORTAL, self.session, "org.freedesktop.portal.Session", "Close",
                          None, None, Gio.DBusCallFlags.NONE, 1000, None, None)
            self.session = None


CANCEL = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p)
WIDTH, HEIGHT = 854, 480


def native_library():
    lib = ctypes.CDLL(os.path.join(APP_LIB, "libwupstream.so"))
    lib.wupstream_open_settings.argtypes = [ctypes.c_char_p, ctypes.c_int, CANCEL, ctypes.c_void_p,
                                            ctypes.c_int, ctypes.c_int]
    lib.wupstream_open_settings.restype = ctypes.c_void_p
    lib.wupstream_frame.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int, ctypes.c_int]
    lib.wupstream_frame.restype = ctypes.c_int
    lib.wupstream_link.argtypes = [ctypes.c_void_p] + [ctypes.POINTER(ctypes.c_int)] * 3
    lib.wupstream_link.restype = ctypes.c_int
    lib.wupstream_input.argtypes = [ctypes.c_void_p, ctypes.POINTER(PadInput)]
    lib.wupstream_input.restype = ctypes.c_int
    lib.wupstream_interrupt.argtypes = [ctypes.c_void_p]
    lib.wupstream_interrupt.restype = None
    lib.wupstream_close.argtypes = [ctypes.c_void_p]
    lib.wupstream_close.restype = None
    return lib


def open_issue_url(url):
    if not os.environ.get("APPIMAGE"):
        return webbrowser.open(url)
    env = os.environ.copy()
    for name in ("PYTHONHOME", "PYTHONPATH", "GI_TYPELIB_PATH", "GSETTINGS_SCHEMA_DIR",
                 "GDK_PIXBUF_MODULE_FILE", "GST_PLUGIN_SYSTEM_PATH_1_0", "GST_PLUGIN_PATH_1_0",
                 "GST_PLUGIN_SCANNER", "SPA_PLUGIN_DIR", "PIPEWIRE_MODULE_DIR", "PIPEWIRE_CONFIG_DIR"):
        env.pop(name, None)
    for name in ("LD_LIBRARY_PATH", "XDG_DATA_DIRS"):
        value = env.pop("WUP_HOST_" + name, "")
        if value:
            env[name] = value
        else:
            env.pop(name, None)
    subprocess.Popen(["xdg-open", url], env=env)
    return True


