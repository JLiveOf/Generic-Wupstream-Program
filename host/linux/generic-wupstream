    def place(self, widget, x, y, width, height):
        widget.set_size_request(width, height)
        self.layout.put(widget, x, y)

    def label(self, caption, x, y, width, height, style=None):
        widget = Gtk.Label(xalign=0)
        if style:
            widget.get_style_context().add_class(style)
        self.labels.append((widget, caption))
        self.place(widget, x, y, width, height)

    def change_language(self, selector):
        self.english = selector.get_active() == 1
        self.apply_language()

    def refresh_button(self):
        if not self.worker and not self.pending:
            self.button.set_label(self.tr("Conectar por IP" if self.address.get_text().strip() else "Buscar GamePad"))

    def apply_language(self):
        for widget, caption in self.labels:
            widget.set_text(self.tr(caption))
        for widget, caption in ((self.video, "Enviar pantalla"), (self.xbox, "ABXY por posición Xbox"),
                                (self.report, "Reportar un problema en GitHub")):
            widget.set_label(self.tr(caption))
        for combo, options in ((self.backend, ("Automática", "X11", "Wayland (PipeWire)")),
                               (self.quality, ("Baja", "Media", "Alta"))):
            previous = combo.get_active()
            combo.remove_all()
            for option in options:
                combo.append_text(self.tr(option))
            combo.set_active(previous)
        self.address.get_accessible().set_name(self.tr("IP del GamePad (opcional)"))
        self.backend.get_accessible().set_name(self.tr("Captura"))
        self.fps.get_accessible().set_name("FPS")
        self.quality.get_accessible().set_name(self.tr("Calidad"))
        self.status.set_text(self.tr("Introduce la IP de WUP Stream o deja el campo vacío para buscarlo."))
        self.show_state(None, -1, False)
        self.refresh_button()

    def show_state(self, state, battery, charging):
        self.preview.state = state
        self.preview.queue_draw()
        label = self.tr("Batería · —") if battery < 0 else self.tr("Batería · {level} %", level=battery)
        self.battery.set_text(label + (self.tr(" · Cargando") if battery >= 0 and charging else ""))
        return False

    @staticmethod
    def combo(labels, selected):
        control = Gtk.ComboBoxText()
        for label in labels:
            control.append_text(label)
        control.set_active(selected)
        return control

    def update_controls(self, *_):
        idle = not self.pending and self.worker is None
        for control in (self.address, self.video, self.xbox, self.language):
            control.set_sensitive(idle)
        for control in (self.backend, self.fps, self.quality):
            control.set_sensitive(idle and self.video.get_active())

    def on_close(self, *_):
        if self.pending:
            return True
        if self.worker:
            self.closing = True
            self.cancel.set()
            return True
        return False

    def report_issue(self, *_):
        details = "\n".join(self.logs.copy())
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                   text=self.tr("Revisa el diagnóstico antes de abrir el issue"))
        dialog.format_secondary_text(details)
        dialog.add_button(self.tr("Cancelar"), Gtk.ResponseType.CANCEL)
        dialog.add_button(self.tr("Abrir GitHub"), Gtk.ResponseType.OK)
        accepted = dialog.run() == Gtk.ResponseType.OK
        dialog.destroy()
        if accepted:
            body = "\n\n".join("## " + self.tr(section) for section in
                                ("Qué ocurrió", "Cómo reproducirlo", "Diagnóstico de Generic Wupstream"))
            body += "\n\n```text\n" + details + "\n```\n"
            try:
                opened = open_issue_url(ISSUES + "?" + urlencode({"title": "[Linux] ", "body": body}))
            except (OSError, webbrowser.Error):
                opened = False
            if not opened:
                self.status.set_text(self.tr("No se pudo abrir el navegador."))

    def toggle(self, *_):
        if self.worker:
            self.cancel.set()
            self.button.set_sensitive(False)
            self.status.set_text(self.tr("Desconectando…"))
            return
        self.pending = True
        self.update_controls()
        self.button.set_sensitive(False)
        stage = "dirección"
        try:
            address = self.address.get_text().strip()
            if address:
                try:
                    address = str(ipaddress.IPv4Address(address))
                except ValueError as error:
                    raise ValueError(self.tr("Escribe la dirección IPv4 que aparece en WUP Stream.")) from error
            bitrate = [1800, 3200, 5500][self.quality.get_active()]
            if self.video.get_active():
                selected = self.backend.get_active()
                wayland = selected == 2 or (selected == 0 and
                          (os.environ.get("XDG_SESSION_TYPE") == "wayland" or bool(os.environ.get("WAYLAND_DISPLAY"))))
                self.logs.append(f"Captura: {'Wayland' if wayland else 'X11'} · "
                                 f"FPS: {self.fps.get_active_text()} · Calidad: {self.quality.get_active_text()}")
                stage = "portal" if wayland else "captura X11"
                if wayland:
                    self.portal = ScreenCast(self.tr)
                    source = self.portal.open()
                else:
                    source = "ximagesrc use-damage=false show-pointer=true"
                fps = int(self.fps.get_active_text())
                stage = "pipeline GStreamer"
                self.pipeline = Gst.parse_launch(
                    f"{source} ! videoconvert ! videorate drop-only=true ! videoscale add-borders=true"
                    f" ! video/x-raw,format=BGRA,width={WIDTH},height={HEIGHT},pixel-aspect-ratio=1/1,framerate={fps}/1"
                    " ! appsink name=out max-buffers=1 drop=true sync=false")
            else:
                self.logs.append("Modo mando sin captura")
            self.cancel.clear()
            self.status.set_text(self.tr("Esperando al WUP Stream oficial…"))
            self.worker = threading.Thread(target=self.stream, args=(address, bitrate, self.xbox.get_active()))
            self.worker.start()
            self.button.set_label(self.tr("Desconectar"))
        except (OSError, ValueError, RuntimeError, GLib.Error, KeyError, IndexError) as error:
            self.logs.append(f"Error en {stage}: {type(error).__name__}")
            self.finish(str(error))
        finally:
            self.pending = False
            self.update_controls()
            self.button.set_sensitive(True)

    def capture_video(self, lib, pad, errors):
        try:
            if self.pipeline.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
                raise RuntimeError(self.tr("No se pudo iniciar la captura."))
            sink = self.pipeline.get_by_name("out")
            bus = self.pipeline.get_bus()
            while not self.cancel.is_set():
                message = bus.pop_filtered(Gst.MessageType.ERROR | Gst.MessageType.EOS)
                if message:
                    raise RuntimeError(message.parse_error()[0].message if message.type == Gst.MessageType.ERROR
                                       else self.tr("Terminó la captura de pantalla."))
                sample = sink.emit("try-pull-sample", 50 * Gst.MSECOND)
                if sample:
                    buffer = sample.get_buffer()
                    if buffer.get_size() != WIDTH * HEIGHT * 4:
                        raise RuntimeError(self.tr("La captura devolvió un formato de imagen inesperado."))
                    data = buffer.extract_dup(0, buffer.get_size())
                    if lib.wupstream_frame(pad, data, WIDTH * 4, 1):
                        if not self.cancel.is_set():
                            raise RuntimeError(self.tr("Se perdió la conexión con el GamePad."))
                        break
        except (OSError, RuntimeError, GLib.Error) as error:
            errors.append(error)

    def stream(self, address, bitrate, xbox_positions):
        pad = controller = video = None
        video_errors = []
        result = self.tr("Desconectado")
        stage = "mando virtual"
        try:
            try:
                controller = Gamepad(xbox_positions)
                self.logs.append("Mando virtual creado")
            except (OSError, UInputError) as error:
                self.logs.append("Mando virtual no disponible")
                if not self.pipeline:
                    raise RuntimeError(self.tr("No se pudo crear el mando virtual en /dev/uinput. Comprueba el acceso desde tu sesión de Linux.")) from error
            stage = "motor nativo"
            lib = native_library()
            stage = "conexión al receptor oficial"
            expired = CANCEL(lambda _: int(self.cancel.is_set()))
            pad = lib.wupstream_open_settings(address.encode() if address else None, 9000, expired, None, 0, bitrate)
            if not pad:
                if not self.cancel.is_set():
                    result = self.tr("No se pudo conectar. Abre el WUP Stream oficial y verifica su IP.")
                    self.logs.append("El receptor oficial no respondió o no se pudo inicializar el motor.")
                return
            self.logs.append("Conexión establecida")
            if not controller:
                connected = self.tr("Conectado · Vídeo (sin mando virtual)")
            else:
                connected = self.tr("Conectado · Mando virtual y vídeo" if self.pipeline else "Conectado · Mando virtual")
            GLib.idle_add(self.status.set_text, connected)
            if self.pipeline:
                video = threading.Thread(target=self.capture_video, args=(lib, pad, video_errors))
                video.start()
            age, kbps, retries = ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
            state, neutral = PadInput(), PadInput()
            recovering = False
            next_update = 0
            stage = "lectura del GamePad"
            while not self.cancel.is_set():
                if video_errors:
                    self.logs.append("Se detuvo la captura GStreamer; el mando sigue conectado")
                    error = video_errors.pop()
                    if not controller:
                        raise RuntimeError(self.tr("Error de vídeo: {error}", error=error))
                    GLib.idle_add(self.status.set_text, self.tr("Mando conectado · Error de vídeo: {error}", error=error))
                    connected = self.tr("Conectado · Mando virtual")
                received = lib.wupstream_input(pad, ctypes.byref(state))
                link = lib.wupstream_link(pad, ctypes.byref(age), ctypes.byref(kbps), ctypes.byref(retries))
                if received < 0 or link < 0:
                    self.logs.append(f"Enlace perdido · Sin respuesta: {age.value} ms")
                    raise RuntimeError(self.tr("Se perdió la conexión con el GamePad."))
                if controller:
                    controller.report(neutral if link else state)
                now = time.monotonic()
                if now >= next_update:
                    preview = None if link else (state.buttons, state.lx, state.ly, state.rx, state.ry)
                    GLib.idle_add(self.show_state, preview, -1 if link else state.battery, not link and state.charging)
                    next_update = now + 0.045
                if bool(link) != recovering:
                    recovering = bool(link)
                    GLib.idle_add(self.status.set_text, self.tr("Reconectando · Mando en reposo") if recovering else connected)
                self.cancel.wait(0.004)
        except (OSError, RuntimeError, GLib.Error) as error:
            self.logs.append(f"Error en {stage}: {type(error).__name__}")
            result = str(error)
        finally:
            if self.cancel.is_set():
                self.logs.append("Desconexión manual")
            self.cancel.set()
            if pad:
                lib.wupstream_interrupt(pad)
                if video:
                    video.join()
                lib.wupstream_close(pad)
            if controller:
                try:
                    controller.close()
                except OSError:
                    self.logs.append("Error al cerrar el mando virtual")
            GLib.idle_add(self.finish, result)

    def finish(self, message):
        self.worker = None
        if self.pipeline:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None
        if self.portal:
            self.portal.close()
            self.portal = None
        self.refresh_button()
        self.button.set_sensitive(True)
        self.update_controls()
        self.status.set_text(message)
        self.show_state(None, -1, False)
        if self.closing:
            self.destroy()


