                               (self.monitor, ("Elegir en el portal" if self.wayland_session() else "Escritorio completo", *(
                                   monitor.get_model() or f"{self.tr('Monitor')} {index}"
                                   for index, monitor in enumerate(self.monitors, 1)))),
                               (self.quality, ("Baja", "Media", "Alta")),
                               (self.brightness, ("Del GamePad", "1", "2", "3", "4", "5", "6"))):
            previous = combo.get_active()
            combo.remove_all()
            for option in options:
                combo.append_text(self.tr(option))
            combo.set_active(previous)
        self.address.get_accessible().set_name(self.tr("IP del GamePad (opcional)"))
        self.backend.get_accessible().set_name(self.tr("Captura"))
        self.fps.get_accessible().set_name("FPS")
        self.quality.get_accessible().set_name(self.tr("Calidad"))
        self.status.set_text(self.tr("Introduce la IP de WUP Stream o deja el campo vacío para buscarlo."))
        self.show_state(None, -1, False)
        self.refresh_button()

    def show_state(self, state, battery, charging, telemetry=None):
        self.preview.state = state
        self.preview.queue_draw()
        label = self.tr("Batería · —") if battery < 0 else self.tr("Batería · {level} %", level=battery)
        self.battery.set_text(label + (self.tr(" · Cargando") if battery >= 0 and charging else ""))
        volume, accel, gyro = telemetry if telemetry else ("—", ("—",), ("—",))
        self.volume.set_text(self.tr("Volumen del GamePad · {value}", value=volume))
        self.telemetry.set_text(self.tr("Acelerómetro · {accel}     Giroscopio · {gyro}",
                                       accel=", ".join(map(str, accel)), gyro=", ".join(map(str, gyro))))
        return False

    @staticmethod
    def combo(labels, selected):
        control = Gtk.ComboBoxText()
        for label in labels:
            control.append_text(label)
        control.set_active(selected)
        return control

    def update_controls(self, *_):
        idle = not self.pending and self.worker is None
        for control in (self.address, self.video, self.language, self.audio, self.microphone):
            control.set_sensitive(idle)
        for control in (self.virtual_mic, self.record):
            control.set_sensitive(idle and self.microphone.get_active())
        for control in (self.backend, self.fps, self.quality):
            control.set_sensitive(idle and self.video.get_active())
        self.touch.set_sensitive(idle and self.video.get_active())
        self.monitor.set_sensitive(idle and self.video.get_active() and not self.wayland_session())

    @staticmethod
    def wayland_session():
        return os.environ.get("XDG_SESSION_TYPE") == "wayland" or bool(os.environ.get("WAYLAND_DISPLAY"))

    def on_close(self, *_):
        if self.pending:
            return True
        if self.worker:
            self.closing = True
            self.cancel.set()
            return True
        return False

    def report_issue(self, *_):
        details = "\n".join(self.logs.copy())
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                   text=self.tr("Revisa el diagnóstico antes de abrir el issue"))
        dialog.format_secondary_text(details)
        dialog.add_button(self.tr("Cancelar"), Gtk.ResponseType.CANCEL)
        dialog.add_button(self.tr("Abrir GitHub"), Gtk.ResponseType.OK)
        accepted = dialog.run() == Gtk.ResponseType.OK
        dialog.destroy()
        if accepted:
            body = "\n\n".join("## " + self.tr(section) for section in
                                ("Qué ocurrió", "Cómo reproducirlo", "Diagnóstico de Generic Wupstream"))
            body += "\n\n```text\n" + details + "\n```\n"
            try:
                opened = open_issue_url(ISSUES + "?" + urlencode({"title": "[Linux] ", "body": body}))
            except (OSError, webbrowser.Error):
                opened = False
            if not opened:
                self.status.set_text(self.tr("No se pudo abrir el navegador."))

    def toggle(self, *_):
        if self.worker:
            self.cancel.set()
            self.button.set_sensitive(False)
            self.status.set_text(self.tr("Desconectando…"))
            return
        self.pending = True
        self.update_controls()
        self.button.set_sensitive(False)
        stage = "dirección"
        pointer = None
        try:
            address = self.address.get_text().strip()
            self.audio_status.set_text("")
            if address:
                try:
                    address = str(ipaddress.IPv4Address(address))
                except ValueError as error:
                    raise ValueError(self.tr("Escribe la dirección IPv4 que aparece en WUP Stream.")) from error
            bitrate = [1800, 3200, 5500][self.quality.get_active()]
            if self.video.get_active():
                selected = self.backend.get_active()
                wayland = selected == 2 or (selected == 0 and self.wayland_session())
                touch = self.touch.get_active()
                self.logs.append(f"Captura: {'Wayland' if wayland else 'X11'} · "
                                 f"FPS: {self.fps.get_active_text()} · Calidad: {self.quality.get_active_text()}")
                stage = "portal" if wayland else "captura X11"
                if not wayland and self.wayland_session():
                    raise RuntimeError(self.tr("En una sesión Wayland, elige la captura Wayland (PipeWire)."))
                if wayland:
                    self.portal = ScreenCast(self.tr)
                    source = self.portal.open(touch)
                    if touch:
                        pointer = self.portal
                else:
                    source = "ximagesrc use-damage=false show-pointer=true"
                    monitor = self.monitor.get_active()
                    if monitor > 0:
                        geometry = self.monitors[monitor - 1].get_geometry()
                        scale = self.monitors[monitor - 1].get_scale_factor()
                        x, y = geometry.x * scale, geometry.y * scale
                        width, height = geometry.width * scale, geometry.height * scale
                        source += f" startx={x} starty={y} endx={x + width - 1} endy={y + height - 1}"
                    else:
                        screen = Gdk.Screen.get_default()
                        scale = screen.get_root_window().get_scale_factor()
                        x = y = 0
                        width, height = screen.get_width() * scale, screen.get_height() * scale
                    if touch:
                        pointer = X11Pointer(x, y, width, height, screen_point)
                fps = int(self.fps.get_active_text())
                stage = "pipeline GStreamer"
                # The portal can supply a lower rate than the selected limit.
                rate = (f"videorate drop-only=true max-rate={fps}" if wayland
                        else "videorate drop-only=true")
                framerate = "" if wayland else f",framerate={fps}/1"
                pipeline = (
                    f"{source} ! {rate} ! videoconvert ! videoscale add-borders=true"
                    f" ! video/x-raw,format=BGRA,width={WIDTH},height={HEIGHT},pixel-aspect-ratio=1/1{framerate}")
                if wayland and os.environ.get("APPDIR"):
                    self.pipeline = HostWaylandCapture(pipeline, self.portal.fd, self.tr)
                else:
                    self.pipeline = Gst.parse_launch(pipeline + " ! appsink name=out max-buffers=1 drop=true sync=false")
            else:
                self.logs.append("Modo mando sin captura")
            self.cancel.clear()
            self.status.set_text(self.tr("Esperando al WUP Stream oficial…"))
            mic = self.microphone.get_active()
            audio_options = (self.audio.get_active(), mic,
                             mic and self.virtual_mic.get_active(), self.recording_path if mic else None)
            self.worker = threading.Thread(target=self.stream, args=(address, bitrate, audio_options, pointer))
            self.worker.start()
            self.button.set_label(self.tr("Desconectar"))
        except (OSError, ValueError, RuntimeError, GLib.Error, KeyError, IndexError) as error:
            if isinstance(pointer, X11Pointer):
                pointer.close()
            self.logs.append(f"Error en {stage}: {error}")
            self.finish(str(error))
        finally:
            self.pending = False
            self.update_controls()
            self.button.set_sensitive(True)

    def capture_video(self, lib, pad, errors):
        try:
            if isinstance(self.pipeline, HostWaylandCapture):
                first_frame = True
                frames = self.pipeline.frames(self.cancel)
                try:
                    for data in frames:
                        if lib.wupstream_frame(pad, data, WIDTH * 4, 1):
                            if not self.cancel.is_set():
                                raise RuntimeError(self.tr("Se perdió la conexión con el GamePad."))
                            break
                        if first_frame:
                            self.logs.append("Primer fotograma entregado al motor de vídeo")
                            first_frame = False
                finally:
                    frames.close()
                return
            if self.pipeline.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
                raise RuntimeError(self.tr("No se pudo iniciar la captura."))
            sink = self.pipeline.get_by_name("out")
            bus = self.pipeline.get_bus()
            first_frame_deadline = time.monotonic() + 10
            first_frame = True
            while not self.cancel.is_set():
                message = bus.pop_filtered(Gst.MessageType.ERROR | Gst.MessageType.EOS)
                if message:
                    if message.type == Gst.MessageType.ERROR:
                        error, debug = message.parse_error()
                        self.logs.append(f"GStreamer ({message.src.get_name()}): {error.message} · {debug or ''}")
                        raise RuntimeError(error.message)
                    raise RuntimeError(self.tr("Terminó la captura de pantalla."))
                sample = sink.emit("try-pull-sample", 50 * Gst.MSECOND)
                if sample:
                    buffer = sample.get_buffer()
                    if buffer.get_size() != WIDTH * HEIGHT * 4:
                        raise RuntimeError(self.tr("La captura devolvió un formato de imagen inesperado."))
                    data = buffer.extract_dup(0, buffer.get_size())
                    if lib.wupstream_frame(pad, data, WIDTH * 4, 1):
                        if not self.cancel.is_set():
                            raise RuntimeError(self.tr("Se perdió la conexión con el GamePad."))
                        break
                    if first_frame:
                        self.logs.append("Primer fotograma entregado al motor de vídeo")
                        first_frame = False
                elif first_frame and not self.cancel.is_set() and time.monotonic() >= first_frame_deadline:
                    raise RuntimeError(self.tr("La captura no recibió imágenes durante 10 segundos."))
        except (OSError, RuntimeError, GLib.Error) as error:
            errors.append(error)

    def send_controller_frame(self, lib, pad, errors):
        try:
            still = controller_frame(self.tr("Modo mando"))
            if lib.wupstream_frame(pad, still, WIDTH * 4, 1) and not self.cancel.is_set():
                errors.append(RuntimeError(self.tr("Se perdió la conexión con el GamePad.")))
        except cairo.Error as error:
            errors.append(error)

    def stream(self, address, bitrate, audio_options, pointer):
        pad = controller = video = None
        audio = PadAudio(host_environment(), self.tr)
        video_errors = []
        result = self.tr("Desconectado")
        stage = "mando virtual"
        try:
            try:
                controller = Gamepad(self.xbox_positions)
                self.logs.append("Mando virtual creado")
                device = controller.device.device
                GLib.idle_add(self.set_gamepad_path, device.path if device else None)
            except (OSError, UInputError) as error:
                self.logs.append("Mando virtual no disponible")
                if not self.pipeline:
                    raise RuntimeError(self.tr("No se pudo crear el mando virtual en /dev/uinput. Comprueba el acceso desde tu sesión de Linux.")) from error
            stage = "motor nativo"
            lib = native_library()
            stage = "conexión al receptor oficial"
            expired = CANCEL(lambda _: int(self.cancel.is_set()))
            pad = lib.wupstream_open_settings(address.encode() if address else None, 9000, expired, None, 0, bitrate)
            if not pad:
                if not self.cancel.is_set():
                    result = self.tr("No se pudo conectar. Abre el WUP Stream oficial y verifica su IP.")
                    self.logs.append("El receptor oficial no respondió o no se pudo inicializar el motor.")
                return
            self.logs.append("Conexión establecida")
            if not controller:
                connected = self.tr("Conectado · Vídeo (sin mando virtual)")
            else:
                connected = self.tr("Conectado · Mando virtual y vídeo" if self.pipeline else "Conectado · Mando virtual")
            GLib.idle_add(self.status.set_text, connected)
            if self.pipeline:
                video = threading.Thread(target=self.capture_video, args=(lib, pad, video_errors))
            else:
                video = threading.Thread(target=self.send_controller_frame, args=(lib, pad, video_errors))
            video.start()
            desktop_audio, microphone, virtual_mic, recording = audio_options
            audio.open(desktop_audio, virtual_mic, recording)
            GLib.idle_add(self.vibrate.set_sensitive, True)
            age, kbps, retries = ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
            state, neutral = PadInput(), PadInput()
            recovering = False
            next_update = 0
            last_brightness = -1
            rumbling = False
            stage = "lectura del GamePad"
            while not self.cancel.is_set():
                if video_errors:
                    error = video_errors.pop()
                    self.logs.append(f"Se detuvo la captura GStreamer: {error}")
                    if not controller:
                        raise RuntimeError(self.tr("Error de vídeo: {error}", error=error))
                    if pointer:
                        pointer.touch(False)
                        if isinstance(pointer, X11Pointer):
                            pointer.close()
                        pointer = None
                    connected = self.tr("Mando conectado · Error de vídeo: {error}", error=error)
                    GLib.idle_add(self.stop_capture_with_status, connected)
                received = lib.wupstream_input(pad, ctypes.byref(state))
                link = lib.wupstream_link(pad, ctypes.byref(age), ctypes.byref(kbps), ctypes.byref(retries))
                if received < 0 or link < 0:
                    self.logs.append(f"Enlace perdido · Sin respuesta: {age.value} ms")
                    raise RuntimeError(self.tr("Se perdió la conexión con el GamePad."))
                if controller:
                    if controller.xbox_positions != self.xbox_positions:
                        controller.set_xbox_positions(self.xbox_positions)
                    controller.report(neutral if link else state)
                if pointer:
                    pointer.touch(bool(not link and state.touched), state.tx, state.ty)
                if not link:
                    audio.pump(lib, pad, microphone)
                now = time.monotonic()
                if not link and last_brightness != self.brightness_level:
                    last_brightness = self.brightness_level
                    lib.wupstream_backlight(pad, last_brightness, 0)
                game_rumble = controller.rumble(now) if controller else False
                should_rumble = not link and (game_rumble or now < self.vibration_until)
                if should_rumble != rumbling:
                    rumbling = should_rumble
                    lib.wupstream_rumble(pad, int(rumbling))
                if now >= next_update:
                    preview = None if link else (state.buttons, state.lx, state.ly, state.rx, state.ry)
                    telemetry = None if link else (state.volume, tuple(state.accel), tuple(state.gyro))
                    GLib.idle_add(self.show_state, preview, -1 if link else state.battery,
                                  not link and state.charging, telemetry)
                    GLib.idle_add(self.mic_level.set_value, audio.level if not link else 0)
                    if audio.messages:
                        message = " · ".join(audio.messages)
                        self.logs.extend(audio.messages)
                        audio.messages.clear()
                        GLib.idle_add(self.audio_status.set_text, message)
                    next_update = now + 0.045
                if bool(link) != recovering:
                    recovering = bool(link)
                    GLib.idle_add(self.status.set_text, self.tr("Reconectando · Mando en reposo") if recovering else connected)
                self.cancel.wait(0.004)
        except (OSError, RuntimeError, GLib.Error, UInputError) as error:
            self.logs.append(f"Error en {stage}: {type(error).__name__}")
            result = str(error)
        finally:
            if self.cancel.is_set():
                self.logs.append("Desconexión manual")
            self.cancel.set()
            if pointer:
                pointer.touch(False)
                if isinstance(pointer, X11Pointer):
                    pointer.close()
            audio.close()
            self.logs.extend(audio.messages)
            if pad:
                lib.wupstream_rumble(pad, 0)
                lib.wupstream_interrupt(pad)
                if video:
                    video.join()
                lib.wupstream_close(pad)
            if controller:
                try:
                    controller.close()
                except OSError:
                    self.logs.append("Error al cerrar el mando virtual")
            GLib.idle_add(self.finish, result)

    def stop_capture(self):
        if self.pipeline:
            if not isinstance(self.pipeline, HostWaylandCapture):
                self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None
        if self.portal:
            self.portal.close()
            self.portal = None

    def stop_capture_with_status(self, message):
        self.stop_capture()
        self.status.set_text(message)

    def finish(self, message):
        self.worker = None
        self.vibration_until = 0
        self.vibrate.set_sensitive(False)
        self.set_gamepad_path(None)
        self.mic_level.set_value(0)
        self.stop_capture()
        self.refresh_button()
        self.button.set_sensitive(True)
        self.update_controls()
        self.status.set_text(message)
        self.show_state(None, -1, False)
        if self.closing:
            self.destroy()


