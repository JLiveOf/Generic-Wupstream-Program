class ScreenCast:
    def __init__(self, tr):
        self.tr = tr
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.session = None
        self.fd = None
        self.touch_pressed = False
        self.touch_position = None

    def request(self, method, signature, arguments, options, interface=SCREENCAST):
        token = "wup_" + uuid.uuid4().hex
        options["handle_token"] = GLib.Variant("s", token)
        sender = self.bus.get_unique_name()[1:].replace(".", "_")
        path = f"{PORTAL_PATH}/request/{sender}/{token}"
        loop = GLib.MainLoop()
        response = []

        def received(bus, sender, object_path, interface, signal, parameters, *_):
            response.extend(parameters.unpack())
            loop.quit()

        listener = self.bus.signal_subscribe(PORTAL, "org.freedesktop.portal.Request",
                                             "Response", path, None, Gio.DBusSignalFlags.NONE, received)
        deadline = GLib.timeout_source_new_seconds(90)
        deadline.set_callback(lambda *_: loop.quit() or GLib.SOURCE_REMOVE)
        deadline.attach(None)
        try:
            handle = self.bus.call_sync(PORTAL, PORTAL_PATH, interface, method,
                                        GLib.Variant(signature, (*arguments, options)), None,
                                        Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
            if handle != path:
                raise RuntimeError(self.tr("El portal devolvió una ruta de solicitud inesperada."))
            if not response:
                loop.run()
            if not response:
                self.bus.call(PORTAL, path, "org.freedesktop.portal.Request", "Close",
                              None, None, Gio.DBusCallFlags.NONE, 1000, None, None)
                raise RuntimeError(self.tr("El portal de captura no respondió."))
            if response[0] == 1:
                raise RuntimeError(self.tr("Se canceló la captura de pantalla."))
            if response[0] != 0:
                raise RuntimeError(self.tr("El portal no pudo iniciar la captura ({method}).", method=method))
            return response[1]
        finally:
            deadline.destroy()
            self.bus.signal_unsubscribe(listener)

    def open(self, touch):
        interface = REMOTE_DESKTOP if touch else SCREENCAST
        session_token = GLib.Variant("s", "wup_" + uuid.uuid4().hex)
        self.session = self.request("CreateSession", "(a{sv})", (),
                                    {"session_handle_token": session_token}, interface)["session_handle"]
        modes = self.bus.call_sync(PORTAL, PORTAL_PATH, "org.freedesktop.DBus.Properties", "Get",
                                   GLib.Variant("(ss)", (SCREENCAST, "AvailableCursorModes")), None,
                                   Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]
        self.request("SelectSources", "(oa{sv})", (self.session,),
                     {"types": GLib.Variant("u", 1), "cursor_mode": GLib.Variant("u", 2 if modes & 2 else 1)})
        if touch:
            self.request("SelectDevices", "(oa{sv})", (self.session,),
                         {"types": GLib.Variant("u", 2)}, interface)
        started = self.request("Start", "(osa{sv})", (self.session, ""), {}, interface)
        if touch and not started.get("devices", 0) & 2:
            raise RuntimeError(self.tr("El portal no concedió acceso al puntero."))
        self.stream, properties = started["streams"][0]
        self.size = properties.get("size")
        if touch and (not self.size or min(self.size) <= 0):
            raise RuntimeError(self.tr("El portal no informó del tamaño del monitor."))
        result, descriptor_list = self.bus.call_with_unix_fd_list_sync(
            PORTAL, PORTAL_PATH, SCREENCAST, "OpenPipeWireRemote",
            GLib.Variant("(oa{sv})", (self.session, {})), None,
            Gio.DBusCallFlags.NONE, 5000, None, None)
        self.fd = descriptor_list.get(result.unpack()[0])
        # The CPU encoder consumes system-memory frames, not DMA-BUF handles.
        return f"pipewiresrc fd={self.fd} path={self.stream} ! video/x-raw"

    def touch(self, pressed, x=0, y=0):
        if pressed:
            position = screen_point(x, y, *self.size)
            if position != self.touch_position:
                self.touch_position = position
                self.bus.call(PORTAL, PORTAL_PATH, REMOTE_DESKTOP, "NotifyPointerMotionAbsolute",
                              GLib.Variant("(oa{sv}udd)", (self.session, {}, self.stream, *position)),
                              None, Gio.DBusCallFlags.NONE, 1000, None, None)
        if pressed != self.touch_pressed:
            self.touch_pressed = pressed
            self.bus.call(PORTAL, PORTAL_PATH, REMOTE_DESKTOP, "NotifyPointerButton",
                          GLib.Variant("(oa{sv}iu)", (self.session, {}, 272, int(pressed))),
                          None, Gio.DBusCallFlags.NONE, 1000, None, None)

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None
        if self.session:
            if self.touch_pressed:
                self.touch(False)
            self.bus.call(PORTAL, self.session, "org.freedesktop.portal.Session", "Close",
                          None, None, Gio.DBusCallFlags.NONE, 1000, None, None)
            self.session = None


CANCEL = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p)
WIDTH, HEIGHT = 854, 480


def screen_point(x, y, width, height):
    scale = min(WIDTH / width, HEIGHT / height)
    offset_x = (WIDTH - width * scale) / 2
    offset_y = (HEIGHT - height * scale) / 2
    return (max(0.0, min(width - 1.0, (x - offset_x) / scale)),
            max(0.0, min(height - 1.0, (y - offset_y) / scale)))


def controller_frame(label):
    surface = cairo.ImageSurface(cairo.FORMAT_RGB24, WIDTH, HEIGHT)
    context = cairo.Context(surface)
    context.set_source_rgb(0.04, 0.07, 0.12)
    context.paint()
    context.set_source_rgb(0.94, 0.97, 1)
    context.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    context.set_font_size(45)
    left, top, width, height, _, _ = context.text_extents(label)
    context.move_to((WIDTH - width) / 2 - left, (HEIGHT - height) / 2 - top)
    context.show_text(label)
    surface.flush()
    return bytes(surface.get_data())


