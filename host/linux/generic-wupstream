def host_environment():
    env = os.environ.copy()
    if not env.get("APPDIR"):
        return env
    for name in ("PYTHONHOME", "PYTHONPATH", "GI_TYPELIB_PATH", "GSETTINGS_SCHEMA_DIR",
                 "GDK_PIXBUF_MODULE_FILE", "GST_PLUGIN_SYSTEM_PATH_1_0", "GST_PLUGIN_PATH_1_0",
                 "GST_PLUGIN_SCANNER", "SPA_PLUGIN_DIR", "PIPEWIRE_MODULE_DIR", "PIPEWIRE_CONFIG_DIR"):
        env.pop(name, None)
    for name in ("LD_LIBRARY_PATH", "XDG_DATA_DIRS", "XDG_DATA_HOME"):
        value = env.pop("WUP_HOST_" + name, "")
        if value:
            env[name] = value
        else:
            env.pop(name, None)
    return env


def open_issue_url(url):
    if not os.environ.get("APPDIR"):
        return webbrowser.open(url)
    subprocess.Popen(["xdg-open", url], env=host_environment())
    return True


class HostWaylandCapture:
    """Use the desktop's GStreamer and PipeWire for its portal connection."""
    def __init__(self, pipeline, fd, tr):
        self.command = shutil.which("gst-launch-1.0")
        if not self.command:
            raise RuntimeError(tr("Instala GStreamer y el complemento PipeWire del sistema para capturar en Wayland."))
        self.args = [self.command, "-q", *shlex.split(pipeline), "!", "queue", "leaky=downstream",
                     "max-size-buffers=1", "max-size-bytes=0", "max-size-time=0",
                     "!", "fdsink", "fd=1", "sync=false"]
        self.fd = fd
        self.tr = tr

    def frames(self, cancel):
        with tempfile.TemporaryFile() as diagnostics:
            process = subprocess.Popen(self.args, stdout=subprocess.PIPE, stderr=diagnostics,
                                       env=host_environment(), pass_fds=(self.fd,))
            try:
                fd = process.stdout.fileno()
                size = WIDTH * HEIGHT * 4
                frame = bytearray()
                deadline = time.monotonic() + 10
                while not cancel.is_set():
                    if not select.select([fd], [], [], 0.05)[0]:
                        if deadline is not None and time.monotonic() >= deadline:
                            raise RuntimeError(self.tr("La captura no recibió imágenes durante 10 segundos."))
                        continue
                    data = os.read(fd, size - len(frame))
                    if not data:
                        diagnostics.seek(max(0, diagnostics.seek(0, os.SEEK_END) - 4096))
                        lines = diagnostics.read().decode(errors="replace").strip()
                        raise RuntimeError(lines or self.tr("Terminó la captura de pantalla."))
                    frame.extend(data)
                    if len(frame) == size:
                        deadline = None
                        yield bytes(frame)
                        frame.clear()
            finally:
                if process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=1)
                    except subprocess.TimeoutExpired:
                        process.kill()
                process.wait()
                process.stdout.close()


